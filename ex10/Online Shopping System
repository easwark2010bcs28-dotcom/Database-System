        table.setRowHeight(24);
        table.setFont(new Font("SansSerif", Font.PLAIN, 13));
        table.getTableHeader().setFont(new Font("SansSerif", Font.BOLD, 13));
        table.getColumnModel().getColumn(0).setMaxWidth(50);
        table.setSelectionBackground(new Color(174, 214, 241));

        loadProducts(prodModel);

        JPanel searchBar = new JPanel(new FlowLayout(FlowLayout.LEFT, 8, 4));
        JTextField searchField = new JTextField(18);
        JButton searchBtn = new JButton("Search");
        JButton resetBtn  = new JButton("Reset");
        styleButton(searchBtn, new Color(41, 128, 185),  Color.WHITE);
        styleButton(resetBtn,  new Color(149, 165, 166), Color.WHITE);
        searchBar.add(new JLabel("Search:")); searchBar.add(searchField);
        searchBar.add(searchBtn); searchBar.add(resetBtn);

        searchBtn.addActionListener(e -> {
            String kw = searchField.getText().trim().toLowerCase();
            prodModel.setRowCount(0);
            try {
                PreparedStatement ps = con.prepareStatement(
                    "SELECT product_id, product_name, category, price, stock_quantity " +
                    "FROM products WHERE LOWER(product_name) LIKE ? OR LOWER(category) LIKE ?");
                ps.setString(1, "%" + kw + "%"); ps.setString(2, "%" + kw + "%");
                ResultSet rs = ps.executeQuery();
                while (rs.next()) prodModel.addRow(new Object[]{
                    rs.getInt(1), rs.getString(2), rs.getString(3),
                    String.format("%.2f", rs.getDouble(4)), rs.getInt(5)});
                ps.close();
            } catch (Exception ex) {
                JOptionPane.showMessageDialog(parent, ex.getMessage());
            }
        });
        resetBtn.addActionListener(e -> { searchField.setText(""); loadProducts(prodModel); });

        JPanel bottom = new JPanel(new FlowLayout(FlowLayout.LEFT, 10, 6));
        JTextField qtyField = new JTextField("1", 5);
        JButton addCartBtn = new JButton("Add to Cart");
        JButton buyNowBtn  = new JButton("Buy Now");
        styleButton(addCartBtn, new Color(39, 174, 96),   Color.WHITE);
        styleButton(buyNowBtn,  new Color(41, 128, 185),  Color.WHITE);
        bottom.add(new JLabel("Quantity:"));
        bottom.add(qtyField);
        bottom.add(addCartBtn);
        bottom.add(buyNowBtn);

        // FIX 2: Add to Cart now also persists to DB
        addCartBtn.addActionListener(e -> {
            int row = table.getSelectedRow();
            if (row == -1) { JOptionPane.showMessageDialog(parent, "Select a product first."); return; }
            int pid   = (int) prodModel.getValueAt(row, 0);
            int stock = Integer.parseInt(prodModel.getValueAt(row, 4).toString());
            int qty;
            try { qty = Integer.parseInt(qtyField.getText().trim()); }
            catch (NumberFormatException ex) { JOptionPane.showMessageDialog(parent, "Invalid quantity."); return; }
            if (qty <= 0) { JOptionPane.showMessageDialog(parent, "Quantity must be > 0."); return; }
            int already = cart.getOrDefault(pid, 0);
            if (already + qty > stock) {
                JOptionPane.showMessageDialog(parent, "Only " + (stock - already) + " units available."); return;
            }
            cart.merge(pid, qty, Integer::sum);
            // Persist updated quantity to DB
            saveCartItemToDB(pid, cart.get(pid));
            JOptionPane.showMessageDialog(parent,
                prodModel.getValueAt(row, 1) + " (x" + qty + ") added to cart ✅");
            qtyField.setText("1");
        });

        buyNowBtn.addActionListener(e -> {
            int row = table.getSelectedRow();
            if (row == -1) { JOptionPane.showMessageDialog(parent, "Select a product first."); return; }
            int pid   = (int) prodModel.getValueAt(row, 0);
            int stock = Integer.parseInt(prodModel.getValueAt(row, 4).toString());
            int qty;
            try { qty = Integer.parseInt(qtyField.getText().trim()); }
            catch (NumberFormatException ex) { JOptionPane.showMessageDialog(parent, "Invalid quantity."); return; }
            if (qty <= 0) { JOptionPane.showMessageDialog(parent, "Quantity must be > 0."); return; }
            if (qty > stock) {
                JOptionPane.showMessageDialog(parent, "Only " + stock + " units in stock."); return;
            }
            HashMap<Integer, Integer> buyNowCart = new HashMap<>();
            buyNowCart.put(pid, qty);
            placeOrderFromMap(parent, buyNowCart);
            loadProducts(prodModel);
            qtyField.setText("1");
        });

        p.add(searchBar,            BorderLayout.NORTH);
        p.add(new JScrollPane(table), BorderLayout.CENTER);
        p.add(bottom,               BorderLayout.SOUTH);
        return p;
    }

