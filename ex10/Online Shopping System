    // ===================== CART DB PERSISTENCE =====================

    /**
     * FIX 2: Load this customer's saved cart from the DB into the in-memory HashMap.
     * Called on every login so cart survives logout/re-login.
     */
    static void loadCartFromDB() {
        cart.clear();
        try {
            PreparedStatement ps = con.prepareStatement(
                "SELECT product_id, quantity FROM cart WHERE customer_id = ?");
            ps.setInt(1, currentCustomerId);
            ResultSet rs = ps.executeQuery();
            while (rs.next()) {
                cart.put(rs.getInt("product_id"), rs.getInt("quantity"));
            }
            ps.close();
        } catch (Exception ex) {
            // cart table might not exist yet; silently continue with empty cart
            System.out.println("loadCartFromDB: " + ex.getMessage());
        }
    }

    /**
     * FIX 2: Persist a single product's quantity to the DB cart table.
     * Uses MERGE (upsert) so it works for both add and update.
     */
    static void saveCartItemToDB(int productId, int quantity) {
        try {
            // Try update first
            PreparedStatement upd = con.prepareStatement(
                "UPDATE cart SET quantity = ? WHERE customer_id = ? AND product_id = ?");
            upd.setInt(1, quantity);
            upd.setInt(2, currentCustomerId);
            upd.setInt(3, productId);
            int rows = upd.executeUpdate();
            upd.close();
            if (rows == 0) {
                // Row doesn't exist, insert it
                PreparedStatement ins = con.prepareStatement(
                    "INSERT INTO cart (customer_id, product_id, quantity) VALUES (?, ?, ?)");
                ins.setInt(1, currentCustomerId);
                ins.setInt(2, productId);
                ins.setInt(3, quantity);
                ins.executeUpdate();
                ins.close();
            }
        } catch (Exception ex) {
            System.out.println("saveCartItemToDB: " + ex.getMessage());
        }
    }

    /**
     * FIX 2: Remove a single product from the DB cart table.
     */
    static void removeCartItemFromDB(int productId) {
        try {
            PreparedStatement ps = con.prepareStatement(
                "DELETE FROM cart WHERE customer_id = ? AND product_id = ?");
            ps.setInt(1, currentCustomerId);
            ps.setInt(2, productId);
            ps.executeUpdate();
            ps.close();
        } catch (Exception ex) {
            System.out.println("removeCartItemFromDB: " + ex.getMessage());
        }
    }

    /**
     * FIX 2: Clear the entire DB cart for this customer.
     */
    static void clearCartInDB() {
        try {
            PreparedStatement ps = con.prepareStatement(
                "DELETE FROM cart WHERE customer_id = ?");
            ps.setInt(1, currentCustomerId);
            ps.executeUpdate();
            ps.close();
        } catch (Exception ex) {
            System.out.println("clearCartInDB: " + ex.getMessage());
        }
    }

