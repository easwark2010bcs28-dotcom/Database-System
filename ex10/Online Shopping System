    static void adminSaveProduct(JFrame parent) {
        String name   = apName.getText().trim();
        String cat    = apCat.getText().trim();
        String priceS = apPrice.getText().trim();
        String stockS = apStock.getText().trim();
        String desc   = apDesc.getText().trim();
        String idS    = apIdField.getText().trim();

        if (!idS.isEmpty()) {
            try {
                int id = Integer.parseInt(idS);
                PreparedStatement fetchPs = con.prepareStatement(
                    "SELECT product_name, category, price, stock_quantity, description " +
                    "FROM products WHERE product_id = ?");
                fetchPs.setInt(1, id);
                ResultSet rs = fetchPs.executeQuery();
                if (!rs.next()) {
                    JOptionPane.showMessageDialog(parent, "Product ID not found ❌"); return;
                }
                String finalName   = name.isEmpty()    ? rs.getString(1) : name;
                String finalCat    = cat.isEmpty()     ? rs.getString(2) : cat;
                String finalPriceS = priceS.isEmpty()  ? String.valueOf(rs.getDouble(3)) : priceS;
                String finalStockS = stockS.isEmpty()  ? String.valueOf(rs.getInt(4))    : stockS;
                String finalDesc   = desc.isEmpty()    ? (rs.getString(5) != null ? rs.getString(5) : "") : desc;
                fetchPs.close();

                double price; int stock;
                try { price = Double.parseDouble(finalPriceS); stock = Integer.parseInt(finalStockS); }
                catch (NumberFormatException ex) {
                    JOptionPane.showMessageDialog(parent, "Invalid price or stock value."); return;
                }

                PreparedStatement ps = con.prepareStatement(
                    "UPDATE products SET product_name = ?, category = ?, price = ?, " +
                    "stock_quantity = ?, description = ? WHERE product_id = ?");
                ps.setString(1, finalName); ps.setString(2, finalCat);
                ps.setDouble(3, price);     ps.setInt(4, stock);
                ps.setString(5, finalDesc.isEmpty() ? null : finalDesc);
                ps.setInt(6, id);
                ps.executeUpdate();
                ps.close();

                JOptionPane.showMessageDialog(parent, "Product updated ✅");
                apIdField.setText(""); apName.setText(""); apCat.setText("");
                apPrice.setText(""); apStock.setText(""); apDesc.setText("");
                refreshAdminProducts();

            } catch (NumberFormatException ex) {
                JOptionPane.showMessageDialog(parent, "Invalid Product ID.");
            } catch (Exception ex) {
                JOptionPane.showMessageDialog(parent, "Error: " + ex.getMessage());
            }
            return;
        }

        if (name.isEmpty() || cat.isEmpty() || priceS.isEmpty() || stockS.isEmpty()) {
            JOptionPane.showMessageDialog(parent, "Name, Category, Price and Stock are required."); return;
        }
        try {
            double price = Double.parseDouble(priceS);
            int    stock = Integer.parseInt(stockS);

            ResultSet maxRs = con.createStatement().executeQuery(
                "SELECT NVL(MAX(product_id), 0) FROM products");
            maxRs.next();
            int maxId = maxRs.getInt(1);
            maxRs.close();

            int seqVal = 0;
            do {
                ResultSet nxRs = con.createStatement().executeQuery(
                    "SELECT product_seq.NEXTVAL FROM DUAL");
                nxRs.next();
                seqVal = nxRs.getInt(1);
                nxRs.close();
            } while (seqVal <= maxId);

            PreparedStatement ps = con.prepareStatement(
                "INSERT INTO products (product_id, product_name, category, price, stock_quantity, description) " +
                "VALUES (?, ?, ?, ?, ?, ?)");
            ps.setInt(1, seqVal);
            ps.setString(2, name); ps.setString(3, cat);
            ps.setDouble(4, price); ps.setInt(5, stock);
            ps.setString(6, desc.isEmpty() ? null : desc);
            ps.executeUpdate();
            ps.close();

            JOptionPane.showMessageDialog(parent, "Product added ✅");
            apIdField.setText(""); apName.setText(""); apCat.setText("");
            apPrice.setText(""); apStock.setText(""); apDesc.setText("");
            refreshAdminProducts();

        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(parent, "Invalid price or stock value.");
        } catch (Exception ex) {
            JOptionPane.showMessageDialog(parent, "Error: " + ex.getMessage());
        }
    }

    static void adminDeleteProduct(JFrame parent) {
        String idS = apDelId.getText().trim();
        if (idS.isEmpty()) { JOptionPane.showMessageDialog(parent, "Enter product ID to delete."); return; }
        int id;
        try { id = Integer.parseInt(idS); }
        catch (NumberFormatException e) { JOptionPane.showMessageDialog(parent, "Invalid ID."); return; }
        int c = JOptionPane.showConfirmDialog(parent, "Delete product ID " + id + "?", "Confirm", JOptionPane.YES_NO_OPTION);
        if (c != JOptionPane.YES_OPTION) return;
        try {
            PreparedStatement ps = con.prepareStatement("DELETE FROM products WHERE product_id = ?");
            ps.setInt(1, id);
            int rows = ps.executeUpdate();
            ps.close();
            if (rows > 0) { JOptionPane.showMessageDialog(parent, "Deleted ✅"); apDelId.setText(""); }
            else JOptionPane.showMessageDialog(parent, "ID not found ❌");
            refreshAdminProducts();
        } catch (Exception ex) {
            JOptionPane.showMessageDialog(parent, "Error: " + ex.getMessage());
        }
    }

