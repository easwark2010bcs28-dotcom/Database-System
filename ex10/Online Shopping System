    // ===================== REGISTER =====================
    static void registerForm(JFrame parent) {
        JDialog d = new JDialog(parent, "Register", true);
        d.setSize(360, 310);
        d.setLocationRelativeTo(parent);
        d.setLayout(null);

        JLabel title = new JLabel("Create Account", SwingConstants.CENTER);
        title.setFont(new Font("SansSerif", Font.BOLD, 16));
        title.setBounds(0, 12, 360, 28);

        JTextField  name  = new JTextField();    name.setBounds(130,  55, 170, 28);
        JTextField  email = new JTextField();   email.setBounds(130,  95, 170, 28);
        JTextField  phone = new JTextField();   phone.setBounds(130, 135, 170, 28);
        JPasswordField pass = new JPasswordField(); pass.setBounds(130, 175, 170, 28);

        String[] lblTxt = {"Name *", "Email *", "Phone *", "Password *"};
        int[]    lblY   = {55, 95, 135, 175};
        for (int i = 0; i < 4; i++) {
            JLabel l = new JLabel(lblTxt[i]);
            l.setBounds(20, lblY[i], 100, 28);
            d.add(l);
        }

        JButton submit = new JButton("Register");
        JButton cancel = new JButton("Cancel");
        submit.setBounds(60,  225, 110, 32);
        cancel.setBounds(185, 225, 110, 32);
        styleButton(submit, new Color(39, 174, 96),   Color.WHITE);
        styleButton(cancel, new Color(149, 165, 166), Color.WHITE);

        d.add(title); d.add(name); d.add(email); d.add(phone); d.add(pass);
        d.add(submit); d.add(cancel);

        submit.addActionListener(e -> {
            String n  = name.getText().trim();
            String em = email.getText().trim();
            String ph = phone.getText().trim();
            String pw = new String(pass.getPassword()).trim();

            if (n.isEmpty() || em.isEmpty() || ph.isEmpty() || pw.isEmpty()) {
                JOptionPane.showMessageDialog(d, "Please fill all fields."); return;
            }
            if (!em.matches("^[\\w._%+\\-]+@[\\w.\\-]+\\.[a-zA-Z]{2,}$")) {
                JOptionPane.showMessageDialog(d, "Invalid email format."); return;
            }
            if (!ph.matches("\\d{10}")) {
                JOptionPane.showMessageDialog(d, "Phone must be 10 digits."); return;
            }
            try {
                PreparedStatement chk = con.prepareStatement(
                    "SELECT customer_id FROM customers WHERE email = ?");
                chk.setString(1, em);
                ResultSet chkRs = chk.executeQuery();
                if (chkRs.next()) {
                    JOptionPane.showMessageDialog(d, "Email already registered."); return;
                }
                chk.close();

                ResultSet cMaxRs = con.createStatement().executeQuery(
                    "SELECT NVL(MAX(customer_id), 0) FROM customers");
                cMaxRs.next();
                int cMax = cMaxRs.getInt(1);
                cMaxRs.close();
                int cSeq = 0;
                do {
                    ResultSet cNx = con.createStatement().executeQuery(
                        "SELECT customer_seq.NEXTVAL FROM DUAL");
                    cNx.next(); cSeq = cNx.getInt(1); cNx.close();
                } while (cSeq <= cMax);

                PreparedStatement ps = con.prepareStatement(
                    "INSERT INTO customers (customer_id, name, email, phone, password, address, created_date) " +
                    "VALUES (?, ?, ?, ?, ?, NULL, SYSDATE)");
                ps.setInt(1, cSeq);
                ps.setString(2, n);
                ps.setString(3, em);
                ps.setString(4, ph);
                ps.setString(5, pw);
                ps.executeUpdate();
                ps.close();

                JOptionPane.showMessageDialog(d, "Registered successfully! Please login.");
                d.dispose();
            } catch (Exception ex) {
                JOptionPane.showMessageDialog(d, "Error: " + ex.getMessage());
            }
        });
        cancel.addActionListener(e -> d.dispose());
        d.setVisible(true);
    }

