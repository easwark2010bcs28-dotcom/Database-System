    static JPanel buildCartTab(JFrame parent) {
        JPanel p = new JPanel(new BorderLayout(6, 6));
        p.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

        String[] cols = {"Product ID", "Name", "Unit Price", "Qty", "Subtotal"};
        cartModel = new DefaultTableModel(cols, 0) {
            public boolean isCellEditable(int r, int c) { return false; }
        };
        JTable table = new JTable(cartModel);
        table.setRowHeight(24);
        table.setFont(new Font("SansSerif", Font.PLAIN, 13));
        table.getTableHeader().setFont(new Font("SansSerif", Font.BOLD, 13));
        table.setSelectionBackground(new Color(174, 214, 241));

        cartTotalLabel = new JLabel("Total: Rs. 0.00");
        cartTotalLabel.setFont(new Font("SansSerif", Font.BOLD, 14));

        JButton removeBtn   = new JButton("Remove Selected");
        JButton clearBtn    = new JButton("Clear Cart");
        JButton checkoutBtn = new JButton("Checkout");
        styleButton(removeBtn,   new Color(231, 76, 60),   Color.WHITE);
        styleButton(clearBtn,    new Color(149, 165, 166), Color.WHITE);
        styleButton(checkoutBtn, new Color(39, 174, 96),   Color.WHITE);

        JPanel bottom = new JPanel(new FlowLayout(FlowLayout.RIGHT, 10, 6));
        bottom.add(removeBtn); bottom.add(clearBtn);
        bottom.add(cartTotalLabel); bottom.add(checkoutBtn);

        // FIX 2: Remove from cart also removes from DB
        removeBtn.addActionListener(e -> {
            int row = table.getSelectedRow();
            if (row == -1) { JOptionPane.showMessageDialog(parent, "Select a cart item."); return; }
            int pid = (int) cartModel.getValueAt(row, 0);
            cart.remove(pid);
            removeCartItemFromDB(pid);
            refreshCartTab();
        });

        // FIX 2: Clear cart also clears DB
        clearBtn.addActionListener(e -> {
            if (cart.isEmpty()) return;
            int c = JOptionPane.showConfirmDialog(parent, "Clear entire cart?", "Confirm", JOptionPane.YES_NO_OPTION);
            if (c == JOptionPane.YES_OPTION) {
                cart.clear();
                clearCartInDB();
                refreshCartTab();
            }
        });

        checkoutBtn.addActionListener(e -> {
            placeOrderFromMap(parent, cart);
            if (!cart.isEmpty()) {
                cart.clear();
                // DB cart is cleared inside placeOrderFromMap on success
                refreshCartTab();
            }
            loadProducts(prodModel);
        });

        p.add(new JScrollPane(table), BorderLayout.CENTER);
        p.add(bottom, BorderLayout.SOUTH);
        return p;
    }

    static void refreshCartTab() {
        if (cartModel == null) return;
        cartModel.setRowCount(0);
        double total = 0;
        for (int pid : cart.keySet()) {
            try {
                PreparedStatement ps = con.prepareStatement(
                    "SELECT product_name, price FROM products WHERE product_id = ?");
                ps.setInt(1, pid);
                ResultSet rs = ps.executeQuery();
                if (rs.next()) {
                    int    qty   = cart.get(pid);
                    double price = rs.getDouble("price");
                    double sub   = price * qty;
                    total += sub;
                    cartModel.addRow(new Object[]{
                        pid, rs.getString("product_name"),
                        String.format("%.2f", price), qty,
                        String.format("%.2f", sub)});
                }
                ps.close();
            } catch (Exception ex) { System.out.println(ex); }
        }
        if (cartTotalLabel != null)
            cartTotalLabel.setText("Total: Rs. " + String.format("%.2f", total));
    }

    // ===================== PLACE ORDER =====================
    static void placeOrderFromMap(JFrame parent, HashMap<Integer, Integer> orderItems) {
        if (orderItems == null || orderItems.isEmpty()) {
            JOptionPane.showMessageDialog(parent, "No items to order."); return;
        }

        String addr = JOptionPane.showInputDialog(parent, "Enter delivery address:");
        if (addr == null || addr.trim().isEmpty()) {
            JOptionPane.showMessageDialog(parent, "Address is required."); return;
        }

        // ── Collect product data into plain Java objects first (all SELECTs done here) ──
        // We store everything we need so zero DB reads happen during INSERT phase.
        int[]    pids   = new int[orderItems.size()];
        int[]    qtys   = new int[orderItems.size()];
        double[] prices = new double[orderItems.size()];
        String[] names  = new String[orderItems.size()];

        StringBuilder summary = new StringBuilder("Order Summary:\n\n");
        double total = 0;
        int idx = 0;

        try {
            for (int pid : orderItems.keySet()) {
                Statement st = con.createStatement();
                ResultSet rs = st.executeQuery(
                    "SELECT product_name, price, stock_quantity FROM products WHERE product_id = " + pid);
                if (!rs.next()) {
                    rs.close(); st.close();
                    JOptionPane.showMessageDialog(parent, "Product ID " + pid + " not found."); return;
                }
                String nm  = rs.getString(1);
                double pr  = rs.getDouble(2);
                int    stk = rs.getInt(3);
                int    qty = orderItems.get(pid);
                rs.close(); st.close();

                if (qty > stk) {
                    JOptionPane.showMessageDialog(parent, nm + " only has " + stk + " in stock."); return;
                }
                pids[idx] = pid; qtys[idx] = qty; prices[idx] = pr; names[idx] = nm;
                total += pr * qty;
                summary.append(String.format("%-22s x%d  Rs.%.2f%n", nm, qty, pr * qty));
                idx++;
            }
        } catch (Exception ex) {
            JOptionPane.showMessageDialog(parent, "Validation error: " + ex.getMessage()); return;
        }
        summary.append(String.format("%n%-24s Rs.%.2f", "TOTAL", total));

        if (JOptionPane.showConfirmDialog(parent, summary.toString(),
                "Confirm Order", JOptionPane.YES_NO_OPTION) != JOptionPane.YES_OPTION) return;

        // ── Get new order_id ──
        int orderId;
        try {
            ResultSet rs = con.createStatement().executeQuery(
                "SELECT NVL(MAX(order_id),0)+1 FROM orderss");
            rs.next(); orderId = rs.getInt(1); rs.close();
        } catch (Exception ex) {
            JOptionPane.showMessageDialog(parent, "Cannot get order ID: " + ex.getMessage()); return;
        }

        // ── Insert everything in one transaction so FK sees parent in same session ──
        try {
            con.setAutoCommit(false);

            // 1) INSERT into orders (the correct parent table that ORDERS_PK belongs to)
            PreparedStatement ps = con.prepareStatement(
                "INSERT INTO orderss(order_id,customer_id,order_date,total_amount,order_status)" +
                " VALUES(?,?,SYSDATE,?,'Pending')");
            ps.setInt(1, orderId); ps.setInt(2, currentCustomerId); ps.setDouble(3, total);
            ps.executeUpdate(); ps.close();

            // 2) INSERT order_items (FK SYS_C008425 references ORDERS_PK — same transaction, passes)
            for (int i = 0; i < idx; i++) {
                ResultSet ri = con.createStatement().executeQuery(
                    "SELECT NVL(MAX(order_item_id),0)+1 FROM order_items");
                ri.next(); int itemId = ri.getInt(1); ri.close();

                PreparedStatement ip = con.prepareStatement(
                    "INSERT INTO order_items(order_item_id,order_id,product_id,quantity,price)" +
                    " VALUES(?,?,?,?,?)");
                ip.setInt(1, itemId); ip.setInt(2, orderId);
                ip.setInt(3, pids[i]); ip.setInt(4, qtys[i]); ip.setDouble(5, prices[i]);
                ip.executeUpdate(); ip.close();

                // 3) Deduct stock
                PreparedStatement up = con.prepareStatement(
                    "UPDATE products SET stock_quantity=stock_quantity-? WHERE product_id=?");
                up.setInt(1, qtys[i]); up.setInt(2, pids[i]);
                up.executeUpdate(); up.close();
            }

            con.commit();
            con.setAutoCommit(true);

        } catch (Exception ex) {
            try { con.rollback(); } catch (Exception ignored) {}
            try { con.setAutoCommit(true); } catch (Exception ignored) {}
            JOptionPane.showMessageDialog(parent, "Order failed: " + ex.getMessage());
            return;
        }

        // Success
        clearCartInDB();
        JOptionPane.showMessageDialog(parent,
            "✅ Order placed!\n\n" + summary +
            "\n\nDeliver to: " + addr.trim() +
            "\nOrder ID: ORD-" + String.format("%04d", orderId),
            "Order Confirmed", JOptionPane.INFORMATION_MESSAGE);
    }

