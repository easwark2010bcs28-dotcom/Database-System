        refreshBtn.addActionListener(e -> refreshAdminCustomers());
        JPanel top = new JPanel(new FlowLayout(FlowLayout.LEFT));
        top.add(refreshBtn);

        p.add(top,                  BorderLayout.NORTH);
        p.add(new JScrollPane(table), BorderLayout.CENTER);
        return p;
    }

    static void refreshAdminCustomers() {
        if (adminCustModel == null) return;
        adminCustModel.setRowCount(0);
        try {
            ResultSet rs = con.createStatement().executeQuery(
                "SELECT customer_id, name, email, phone, address, created_date " +
                "FROM customers ORDER BY customer_id");
            while (rs.next()) adminCustModel.addRow(new Object[]{
                rs.getInt(1), rs.getString(2), rs.getString(3),
                rs.getString(4) != null ? rs.getString(4) : "—",
                rs.getString(5) != null ? rs.getString(5) : "—",
                rs.getDate(6)});
        } catch (Exception e) { System.out.println(e); }
    }

    // ===================== SALES REPORT TAB =====================
    static JTextArea salesArea;
    static double[]  salesRevenue = {};
    static String[]  salesLabels  = {};
    static JPanel    salesChartPanel;

    static JPanel buildSalesTab(JFrame parent) {
        JPanel p = new JPanel(new BorderLayout(6, 6));
        p.setBorder(BorderFactory.createEmptyBorder(8, 8, 8, 8));

        salesArea = new JTextArea();
        salesArea.setFont(new Font("Monospaced", Font.PLAIN, 13));
        salesArea.setEditable(false);

        salesChartPanel = new JPanel() {
            protected void paintComponent(Graphics g) {
                super.paintComponent(g);
                drawSalesChart((Graphics2D) g, getWidth(), getHeight());
            }
        };
        salesChartPanel.setBackground(Color.WHITE);
        salesChartPanel.setBorder(BorderFactory.createTitledBorder("Product-wise Revenue Chart"));
        salesChartPanel.setPreferredSize(new Dimension(600, 240));

        JButton refreshBtn = new JButton("Refresh");
        styleButton(refreshBtn, new Color(142, 68, 173), Color.WHITE);
        refreshBtn.addActionListener(e -> refreshSalesTab());
        JPanel top = new JPanel(new FlowLayout(FlowLayout.LEFT));
        top.add(refreshBtn);

        JSplitPane split = new JSplitPane(JSplitPane.VERTICAL_SPLIT,
            salesChartPanel, new JScrollPane(salesArea));
        split.setResizeWeight(0.5);

        p.add(top,   BorderLayout.NORTH);
        p.add(split, BorderLayout.CENTER);
        return p;
    }

    static void refreshSalesTab() {
        if (salesArea == null) return;
        StringBuilder sb = new StringBuilder();
        sb.append("══════════ SALES REPORT ══════════\n\n");
        sb.append(String.format("%-28s %12s %10s%n", "Product", "Units Sold", "Revenue"));
        sb.append("─".repeat(54)).append("\n");

        java.util.List<String> lblList = new java.util.ArrayList<>();
        java.util.List<Double> revList = new java.util.ArrayList<>();

        try {
            ResultSet rs = con.createStatement().executeQuery(
                "SELECT p.product_name, SUM(oi.quantity) AS units, " +
                "SUM(oi.quantity * oi.price) AS revenue " +
                "FROM order_items oi JOIN products p ON oi.product_id = p.product_id " +
                "GROUP BY p.product_name ORDER BY revenue DESC");

            boolean any = false;
            while (rs.next()) {
                any = true;
                String name = rs.getString("product_name");
                int units   = rs.getInt("units");
                double rev  = rs.getDouble("revenue");
                sb.append(String.format("%-28s %12d Rs.%7.2f%n", name, units, rev));
                lblList.add(name.length() > 12 ? name.substring(0, 12) : name);
                revList.add(rev);
            }
            if (!any) sb.append("  No sales data found.\n");

            sb.append("\n─── Order Status Summary ───\n");
            ResultSet statusRs = con.createStatement().executeQuery(
                "SELECT order_status, COUNT(*) AS cnt, SUM(total_amount) AS total " +
                "FROM orderss GROUP BY order_status");
            while (statusRs.next()) {
                sb.append(String.format("  %-12s : %d orders  Rs.%.2f%n",
                    statusRs.getString(1), statusRs.getInt(2), statusRs.getDouble(3)));
            }

            ResultSet totalRs = con.createStatement().executeQuery(
                "SELECT COUNT(*), SUM(total_amount) FROM orderss");
            if (totalRs.next()) {
                sb.append(String.format("%n  Total Orders: %d   Grand Revenue: Rs.%.2f%n",
                    totalRs.getInt(1), totalRs.getDouble(2)));
            }

        } catch (Exception ex) {
            sb.append("Error: ").append(ex.getMessage()).append("\n");
        }

        salesArea.setText(sb.toString());
        salesRevenue = revList.stream().mapToDouble(Double::doubleValue).toArray();
        salesLabels  = lblList.toArray(new String[0]);
        salesChartPanel.repaint();
    }

    static void drawSalesChart(Graphics2D g, int w, int h) {
        g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        g.setColor(Color.WHITE);
        g.fillRect(0, 0, w, h);

        if (salesRevenue.length == 0) {
            g.setColor(Color.GRAY);
            g.setFont(new Font("SansSerif", Font.PLAIN, 13));
            g.drawString("No sales data. Click Refresh.", w / 2 - 110, h / 2);
            return;
        }

        int padL = 55, padR = 20, padT = 20, padB = 55;
        int chartW = w - padL - padR;
        int chartH = h - padT - padB;

        double maxVal = 0;
        for (double v : salesRevenue) if (v > maxVal) maxVal = v;
        if (maxVal == 0) maxVal = 1;

        int n   = salesRevenue.length;
        int gap = chartW / n;
        int barW = (int)(gap * 0.6);

        Color[] colors = {
            new Color(41, 128, 185), new Color(39, 174, 96),
            new Color(231, 76, 60),  new Color(243, 156, 18),
            new Color(142, 68, 173), new Color(26, 188, 156),
            new Color(52, 73, 94),   new Color(230, 126, 34)
        };

        for (int i = 0; i <= 4; i++) {
            int y = padT + chartH - (int)(chartH * i / 4.0);
            g.setColor(new Color(230, 230, 230));
            g.drawLine(padL, y, padL + chartW, y);
            g.setColor(Color.GRAY);
            g.setFont(new Font("SansSerif", Font.PLAIN, 9));
            g.drawString("Rs." + (int)(maxVal * i / 4), 2, y + 4);
        }

        g.setColor(Color.DARK_GRAY);
        g.drawLine(padL, padT, padL, padT + chartH);
        g.drawLine(padL, padT + chartH, padL + chartW, padT + chartH);

        for (int i = 0; i < n; i++) {
            int barH = (int)(chartH * salesRevenue[i] / maxVal);
            int x = padL + i * gap + (gap - barW) / 2;
            int y = padT + chartH - barH;
            g.setColor(colors[i % colors.length]);
            g.fillRoundRect(x, y, barW, barH, 6, 6);
            g.setColor(colors[i % colors.length].darker());
            g.drawRoundRect(x, y, barW, barH, 6, 6);

            g.setColor(Color.DARK_GRAY);
            g.setFont(new Font("SansSerif", Font.PLAIN, 9));
            String val = "Rs." + (int) salesRevenue[i];
            int tw = g.getFontMetrics().stringWidth(val);
            if (barH > 14) g.drawString(val, x + barW / 2 - tw / 2, y - 3);

            String lbl = i < salesLabels.length ? salesLabels[i] : "";
            int lw = g.getFontMetrics().stringWidth(lbl);
            g.drawString(lbl, x + barW / 2 - lw / 2, padT + chartH + 14);
        }
    }
