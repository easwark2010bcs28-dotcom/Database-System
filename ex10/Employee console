package dbms;
import java.sql.*;
import java.util.Scanner;
import java.util.InputMismatchException;
public class EmployeeConsole {

    static Connection con;
    static Scanner sc;
    public static void main(String[] args) {

        sc = new Scanner(System.in);

        if (!connectDB()) {
            System.out.println(" DB Connection Failed");
            return;
        }

        boolean run = true;

        while(run){
            try{
                System.out.println("\n===== EMPLOYEE MANAGEMENT SYSTEM =====");
                System.out.println("1. Display All Employees");
                System.out.println("2. Display Employee by ID");
                System.out.println("3. Add Employee");
                System.out.println("4. Update Employee");
                System.out.println("5. Delete Employee");
                System.out.println("6. Exit");
                System.out.print("Enter choice: ");

                int ch = sc.nextInt();
                sc.nextLine();

                switch(ch){
                    case 1: displayAll(); break;
                    case 2: displayOne(); break;
                    case 3: addEmployee(); break;
                    case 4: updateEmployee(); break;
                    case 5: deleteEmployee(); break;
                    case 6:
                        System.out.println(" Exiting program");
                        run = false;
                        break;
                    default: System.out.println("Invalid Choice");
                }

            }catch(InputMismatchException e){
                System.out.println(" Enter valid number");
                sc.nextLine();
            }
        }
    }

    
    static boolean connectDB(){
        try{
            Class.forName("oracle.jdbc.driver.OracleDriver");
            con = DriverManager.getConnection(
            "jdbc:oracle:thin:@localhost:1521:xe","system","amirtha");
            System.out.println(" Connected");
            return true;
        }catch(Exception e){
            System.out.println(" DB Error: "+e.getMessage());
            return false;
        }
    }

    static void displayAll(){
        try{
            String q="SELECT * FROM employee ORDER BY employee_id";
            PreparedStatement ps=con.prepareStatement(q);
            ResultSet rs=ps.executeQuery();

            System.out.println("\nID  Name  Salary  Joined  Street  City  Pincode  Email");

            while(rs.next()){
                System.out.println(
                rs.getInt(1)+"  "+
                rs.getString(2)+"  "+
                rs.getDouble(3)+"  "+
                rs.getDate(4)+"  "+
                rs.getString(5)+"  "+
                rs.getString(6)+"  "+
                rs.getInt(7)+"  "+
                rs.getString(8));
            }

        }catch(Exception e){
            System.out.println("Error: "+e.getMessage());
        }
    }
    
    static void displayOne(){
        try{
            System.out.print("Enter ID: ");
            int id=sc.nextInt();

            PreparedStatement ps=con.prepareStatement(
            "SELECT * FROM employee WHERE employee_id=?");

            ps.setInt(1,id);

            ResultSet rs=ps.executeQuery();

            if(rs.next()){
                System.out.println("\n===== Employee Details =====");
                System.out.println("ID: " + rs.getInt(1));
                System.out.println("Name: " + rs.getString(2));
                System.out.println("Salary: " + rs.getDouble(3));
                System.out.println("Joined Date: " + rs.getDate(4));
                System.out.println("Street: " + rs.getString(5));
                System.out.println("City: " + rs.getString(6));
                System.out.println("Pincode: " + rs.getInt(7));
                System.out.println("Email: " + rs.getString(8));
            }else{
                System.out.println(" Not Found");
            }

        }catch(Exception e){
            System.out.println("Error: "+e.getMessage());
        }
    }
    
    static void addEmployee(){
        try{
            System.out.print("Name: ");
            String name=sc.nextLine();

            System.out.print("Salary: ");
            double sal=sc.nextDouble(); sc.nextLine();

            System.out.print("Join Date (YYYY-MM-DD): ");
            String date=sc.nextLine();

            System.out.print("Street: ");
            String st=sc.nextLine();

            System.out.print("City: ");
            String city=sc.nextLine();

            System.out.print("Pincode: ");
            String pinStr = sc.nextLine();

            if(!pinStr.matches("\\d{6}")){
                System.out.println(" Invalid Pincode (must be 6 digits)");
                return;
            }

            int pin = Integer.parseInt(pinStr);

            System.out.print("Email: ");
            String email=sc.nextLine();

            if(!email.matches("^[A-Za-z0-9+_.-]+@[A-Za-z0-9.-]+$")){
                System.out.println(" Invalid Email");
                return;
            }

            PreparedStatement ps=con.prepareStatement(
            "INSERT INTO employee VALUES(emp_seq.NEXTVAL,?,?,?,?,?,?,?)");

            ps.setString(1,name);
            ps.setDouble(2,sal);
            ps.setDate(3,Date.valueOf(date));
            ps.setString(4,st);
            ps.setString(5,city);
            ps.setInt(6,pin);
            ps.setString(7,email);

            ps.executeUpdate();
            System.out.println(" Inserted");

        }catch(Exception e){
            System.out.println("Error: "+e.getMessage());
        }
    }

    //  UPDATE
    static void updateEmployee(){
        try{
            System.out.print("Enter Employee ID: ");
            int id = sc.nextInt(); 
            sc.nextLine();

            System.out.println("\nWhat do you want to update?");
            System.out.println("1. Name");
            System.out.println("2. Salary");
            System.out.println("3. Joined Date");
            System.out.println("4. Street");
            System.out.println("5. City");
            System.out.println("6. Pincode");
            System.out.println("7. Email");
            System.out.println("8. Update All Fields");
            System.out.print("Enter choice: ");
            int ch = sc.nextInt();
            sc.nextLine();
            PreparedStatement ps;
            switch(ch){

                case 1:
                    System.out.print("New Name: ");
                    ps = con.prepareStatement(
                    "UPDATE employee SET employee_name=? WHERE employee_id=?");
                    ps.setString(1, sc.nextLine());
                    ps.setInt(2, id);
                    break;

                case 2:
                    System.out.print("New Salary: ");
                    ps = con.prepareStatement(
                    "UPDATE employee SET salary=? WHERE employee_id=?");
                    ps.setDouble(1, sc.nextDouble());
                    ps.setInt(2, id);
                    break;

                case 3:
                    sc.nextLine();
                    System.out.print("New Date (YYYY-MM-DD): ");
                    ps = con.prepareStatement(
                    "UPDATE employee SET joined_date=? WHERE employee_id=?");
                    ps.setDate(1, Date.valueOf(sc.nextLine()));
                    ps.setInt(2, id);
                    break;

                case 4:
                    System.out.print("New Street: ");
                    ps = con.prepareStatement(
                    "UPDATE employee SET address_street=? WHERE employee_id=?");
                    ps.setString(1, sc.nextLine());
                    ps.setInt(2, id);
                    break;

                case 5:
                    System.out.print("New City: ");
                    ps = con.prepareStatement(
                    "UPDATE employee SET address_city=? WHERE employee_id=?");
                    ps.setString(1, sc.nextLine());
                    ps.setInt(2, id);
                    break;

                case 6:
                    System.out.print("New Pincode: ");
                    ps = con.prepareStatement(
                    "UPDATE employee SET address_pincode=? WHERE employee_id=?");
                    ps.setInt(1, sc.nextInt());
                    ps.setInt(2, id);
                    break;

                case 7:
                    System.out.print("New Email: ");
                    String email = sc.nextLine();

                    if(!email.matches("^[A-Za-z0-9+_.-]+@[A-Za-z0-9.-]+$")){
                        System.out.println("❌ Invalid Email");
                        return;
                    }

                    ps = con.prepareStatement(
                    "UPDATE employee SET email_id=? WHERE employee_id=?");
                    ps.setString(1, email);
                    ps.setInt(2, id);
                    break;

                case 8:
                    ps = con.prepareStatement(
                    "UPDATE employee SET employee_name=?, salary=?, joined_date=?, address_street=?, address_city=?, address_pincode=?, email_id=? WHERE employee_id=?");

                    System.out.print("Name: ");
                    ps.setString(1, sc.nextLine());

                    System.out.print("Salary: ");
                    ps.setDouble(2, sc.nextDouble()); sc.nextLine();

                    System.out.print("Date: ");
                    ps.setDate(3, Date.valueOf(sc.nextLine()));

                    System.out.print("Street: ");
                    ps.setString(4, sc.nextLine());

                    System.out.print("City: ");
                    ps.setString(5, sc.nextLine());

                    System.out.print("Pin: ");
                    ps.setInt(6, sc.nextInt()); sc.nextLine();

                    System.out.print("Email: ");
                    ps.setString(7, sc.nextLine());

                    ps.setInt(8, id);
                    break;

                default:
                    System.out.println("❌ Invalid Choice");
                    return;
            }

            int r = ps.executeUpdate();
            System.out.println(r>0 ? " Updated Successfully" : " ID Not Found");

        }catch(Exception e){
            System.out.println("Error: "+e.getMessage());
        }
    }

    //  DELETE
    static void deleteEmployee(){
        try{
            System.out.print("Enter ID: ");
            int id=sc.nextInt();

            PreparedStatement ps=con.prepareStatement(
            "DELETE FROM employee WHERE employee_id=?");

            ps.setInt(1,id);

            int r=ps.executeUpdate();
            System.out.println(r>0?"Deleted":"Not Found");

        }catch(Exception e){
            System.out.println("Error: "+e.getMessage());
        }
    }
}
