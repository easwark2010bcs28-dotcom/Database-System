    void addActions(){

        insert.addActionListener(e->{
            int t=tab.getSelectedIndex();

            try{

                if(t==0){ // EMPLOYEE

                    if(!e_email.getText().matches("^[A-Za-z0-9+_.-]+@[A-Za-z0-9.-]+$"))
                        throw new Exception("Invalid Email");

                    if(!e_pin.getText().matches("\\d{6}"))
                        throw new Exception("Invalid Pincode");

                    PreparedStatement ps = con.prepareStatement(
                    		"INSERT INTO employee VALUES(emp_seq.NEXTVAL,?,?,?,?,?,?,?)");

                    ps.setString(1, e_name.getText());                 // employee_name
                    ps.setDouble(2, Double.parseDouble(e_salary.getText())); // salary
                    ps.setDate(3, Date.valueOf(e_join.getText()));     // joined_date
                    ps.setString(4, e_street.getText());
                    ps.setString(5, e_city.getText());
                    ps.setInt(6, Integer.parseInt(e_pin.getText()));
                    ps.setString(7, e_email.getText());
                    ps.executeUpdate();
                    e_area.setText("Inserted");
                }

                if(t==1){
                    PreparedStatement ps=con.prepareStatement(
                    "INSERT INTO food_category VALUES(category_seq.NEXTVAL,?,?)");
                    ps.setString(1,c_name.getText());
                    ps.setString(2,c_desc.getText());
                    ps.executeUpdate();
                    c_area.setText("Inserted");
                }

                if(t==2){
                    PreparedStatement ps=con.prepareStatement(
                    "INSERT INTO food_item VALUES(food_seq.NEXTVAL,?,?,?,?,?,?,?,?,?)");

                    ps.setString(1,f_name.getText());
                    ps.setDouble(2,Double.parseDouble(f_price.getText()));
                    ps.setInt(3,Integer.parseInt(f_time.getText()));
                    ps.setString(4,f_spice.getText());
                    ps.setString(5,f_type.getText());

                    
                    ps.setString(6, f_bi.getSelectedItem().toString());
                    ps.setString(7, f_li.getSelectedItem().toString());
                    ps.setString(8, f_di.getSelectedItem().toString());

                    ps.setInt(9,Integer.parseInt(f_cat.getText()));

                    ps.executeUpdate();
                    f_area.setText("Inserted ✅");
                }

                if(t==3){
                    PreparedStatement ps = con.prepareStatement(
                    "INSERT INTO orders (order_id, employee_id, order_type, order_date, delivery_date, delivery_location, total_quantity, total_price) VALUES (order_seq.NEXTVAL,?,?,?,?,?,?,?)");

                    ps.setInt(1, Integer.parseInt(o_emp.getText()));
                    ps.setString(2, o_type.getText());
                    ps.setDate(3, Date.valueOf(o_odate.getText()));
                    ps.setDate(4, Date.valueOf(o_ddate.getText()));
                    ps.setString(5, o_loc.getText());
                    ps.setInt(6, Integer.parseInt(o_qty.getText()));
                    ps.setDouble(7, Double.parseDouble(o_price.getText()));

                    ps.executeUpdate();
                    o_area.setText("Inserted ✅");
                }

            }catch(Exception ex){
                JOptionPane.showMessageDialog(f,ex.getMessage());
            }
